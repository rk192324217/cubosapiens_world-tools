{
  "name": "cubosapiens",
  "private": true,
  "packageManager": "npm@11.6.2",
  "workspaces": [
    "apps/web",
    "apps/api",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "deploy": "turbo run deploy",
    "test": "npm run test:unit && npm run test:selenium && npm run test:appium",
    "test:unit": "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/unit",
    "test:selenium": "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/selenium/tests --runInBand",
    "test:appium": "cross-env CI_VALIDATION_MODE=true node --experimental-vm-modules node_modules/jest/bin/jest.js tests/appium/tests --runInBand"
  },
  "dependencies": {
    "@fortawesome/free-brands-svg-icons": "^7.2.0",
    "@fortawesome/free-regular-svg-icons": "^7.2.0",
    "@fortawesome/free-solid-svg-icons": "^7.2.0",
    "@fortawesome/react-fontawesome": "^3.3.0",
    "@hono/zod-validator": "^0.8.0",
    "@opennextjs/cloudflare": "^1.17.1",
    "@react-three/fiber": "^9.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.7.0",
    "next": "^15.3.0",
    "next-pwa": "^5.6.0",
    "radix-ui": "^1.4.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^9.0.1",
    "rehype-highlight": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.0",
    "selenium-webdriver": "^4.46.0",
    "shadcn": "^4.1.1",
    "tailwind-merge": "^3.5.0",
    "three": "^0.167.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.43",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/selenium-webdriver": "^4.35.6",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.1.7",
    "jest": "^30.4.2",
    "tailwindcss": "^4",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "turbo": "latest",
    "typescript": "^5.9.3",
    "webdriverio": "^9.30.1"
  }
}
